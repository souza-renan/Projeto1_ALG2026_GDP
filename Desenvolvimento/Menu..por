//Modelo inicial menu.
programa
{
	
	funcao inicio()
	{
		inteiro hora = 0, horarestante = 0, fome = 0, felicidade = 0, saude = 0//variaveis criadas apenas para teste.
		escreva("MENU - STATUS ATUAL TAMAGOCHI\n\n")
		escreva("Hora atual: ",hora,"\nHora restante(Até sétimo dia)",horarestante)
		escreva("\n\nFome: ",fome,"\nFelicidade: ",felicidade,"\nSaude: ",saude)
		
	}
}
