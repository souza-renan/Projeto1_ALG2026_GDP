programa
{
    inclua biblioteca Util

    funcao inicio()
    {
        inteiro doente = 10
        inteiro Utilsorteia = 0
        inteiro Utilsorteia2 = 0
        inteiro Utilsorteia3 = 0

        // Sorteia se o pet ficará doente
        Utilsorteia = Util.sorteia(0, 1)

        se (Utilsorteia == 1) {
            escreva("Seu pet está doente\n")

            // Passaram 8 horas

            // Sorteia se haverá tentativa de cura
            Utilsorteia = Util.sorteia(0, 1)

            se (Utilsorteia == 1) {

                // Chance de cura
                Utilsorteia2 = Util.sorteia(0, 9)

                se (Utilsorteia2 <= 2) {
                    escreva("Pet está curado\n")
                    doente = 0
                }
            }

            // Passaram mais 8 horas

            se (doente != 0) {

                // Nova chance de tentar curar
                Utilsorteia = Util.sorteia(0, 1)

                se (Utilsorteia == 1) {

                    // Chance de cura
                    Utilsorteia3 = Util.sorteia(0, 9)

                    se (Utilsorteia3 <= 5) {
                        escreva("Pet está curado\n")
                        doente = 0
                    }
                }
            }

            // Se não conseguiu curado
                doente = 0 
                escreva("Pet esta curado \n")
        }
    }
}
